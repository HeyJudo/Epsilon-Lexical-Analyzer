# sampleCompleteProgram.epl - a VALID εpsilon program.
/* Purpose: use every element of the language proposal at least once:
   all six data types, every keyword, Boolean literal, built-in statistical
   function and noise word, every operator, delimiter and bracket, both
   comment styles, and all six statement types (input, output, assignment,
   conditional, iterative, declaration). Expected: no lexical errors. */

# ---------- Declaration statements (Proposal 2.4, 2.12.6) ----------
let integer sample_size = 0
integer count = 5, total_days, offset = -3
integer score
decimal average_temp = 31.5
decimal growth = 1.01
character grade = 'A'
string dataset_name = "temperatures.csv"
string label = ""
boolean passed = false
boolean is_ready = true
vector temps = [30, 31, 32, 29, 35]
vector readings = [12.5, 15.0,
                   18.25, 21.75]
vector empty_list = []

# ---------- Input statements (Proposal 2.12.1) ----------
input(sample_size)
input from (score)

# ---------- Assignment statements: = and every augmented operator ----------
total_days = 30
count += 10
count -= 2
count *= 3
average_temp /= 2
total_days %= 7
growth ^= 2

# ---------- Arithmetic operators and precedence (Proposal 2.5, 2.10) ----------
integer sum_value = 15 + 5
integer difference = 20 - 8
integer product = 4 * 6
decimal quotient = 10 / 4
integer floor_val = 17 // 5
integer remainder = 10 % 3
integer power = 2 ^ 3 ^ 2
integer grouped = (count + 1) * 5 - sum_value

# ---------- Vectors: vectorized operations, indexing and slicing ----------
vector shifted = temps + 5
vector combined = temps * 2
integer first_temp = temps[0]
vector first_three = temps[0:3]
vector all_temps = temps[]

# ---------- Built-in statistical functions and noise words ----------
decimal temp_mean = mean(temps)
decimal temp_median = median of (temps)
decimal temp_mode = mode(temps)
decimal temp_variance = variance(readings)

# ---------- Output statements (Proposal 2.12.2) ----------
print("Dataset loaded")
print(dataset_name)
print("Score: ", score)
print(the mean(temps))
print using (median of (temps), mode(temps), variance(temps))
print(grade, label, average_temp, quotient)

# ---------- Relational and logical operators ----------
passed = score >= 75 and not passed
is_ready = count == 31 or total_days not= 0
boolean in_range = first_temp > 25 and first_temp < 40
boolean low_variance = temp_variance <= 10.0

# ---------- Conditional statements: if / elif / else, nested ----------
if score >= 90 {
    grade = 'A'
    print("Excellent")
} elif score >= 75 and passed == true {
    grade = 'B'
    if is_ready {
        print("Good, ready for the next dataset")
    }
} elif in_range or low_variance {
    grade = 'C'
} else {
    grade = 'F'
    print("Needs review")
}

# ---------- Iterative statement: while, with a nested while ----------
integer day = 0, reading
while day < 7
{
    reading = 0
    while reading < 3 and is_ready
    {
        print(day, reading)
        reading += 1
    }
    if day % 2 == 0 {
        print("Even day: ", day)
    } else {
        print("Odd day: ", day)
    }
    day += 1
}

print("Done.")
